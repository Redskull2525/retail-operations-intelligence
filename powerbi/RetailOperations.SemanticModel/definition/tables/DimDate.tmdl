/// Calendar for 2025 from data/processed/dim_date.csv. Marked as the model's date table (Date column).
table DimDate
	dataCategory: Time

	column 'Date Key'
		dataType: int64
		isHidden
		summarizeBy: none
		sourceColumn: Date Key

	column Date
		dataType: dateTime
		isKey
		formatString: yyyy-mm-dd
		summarizeBy: none
		sourceColumn: Date

	column Year
		dataType: int64
		formatString: 0
		summarizeBy: none
		sourceColumn: Year

	column 'Quarter Number'
		dataType: int64
		isHidden
		summarizeBy: none
		sourceColumn: Quarter Number

	column Quarter
		dataType: string
		summarizeBy: none
		sourceColumn: Quarter
		sortByColumn: 'Quarter Number'

	column 'Month Number'
		dataType: int64
		isHidden
		summarizeBy: none
		sourceColumn: Month Number

	column Month
		dataType: string
		summarizeBy: none
		sourceColumn: Month
		sortByColumn: 'Month Number'

	column 'Year Month'
		dataType: string
		summarizeBy: none
		sourceColumn: Year Month

	column 'Year Month Number'
		dataType: int64
		isHidden
		summarizeBy: none
		sourceColumn: Year Month Number

	column 'Month Year'
		dataType: string
		summarizeBy: none
		sourceColumn: Month Year
		sortByColumn: 'Year Month Number'

	column Weekday
		dataType: string
		summarizeBy: none
		sourceColumn: Weekday

	partition DimDate-partition = m
		mode: import
		source =
				let
				    Source = Csv.Document(File.Contents(DataFolder & "\dim_date.csv"), [Delimiter = ",", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),
				    Promoted = Table.PromoteHeaders(Source, [PromoteAllScalars = true]),
				    Typed = Table.TransformColumnTypes(Promoted, {{"date_key", Int64.Type}, {"full_date", type date}, {"year", Int64.Type}, {"quarter", Int64.Type}, {"month", Int64.Type}, {"month_name", type text}, {"year_month", type text}, {"day_of_week", type text}}, "en-US"),
				    Renamed = Table.RenameColumns(Typed, {{"date_key", "Date Key"}, {"full_date", "Date"}, {"year", "Year"}, {"quarter", "Quarter Number"}, {"month", "Month Number"}, {"month_name", "Month"}, {"year_month", "Year Month"}, {"day_of_week", "Weekday"}}),
				    AddQuarter = Table.AddColumn(Renamed, "Quarter", each "Q" & Text.From([Quarter Number]), type text),
				    AddMonthYear = Table.AddColumn(AddQuarter, "Month Year", each Date.ToText([Date], "MMM yyyy", "en-US"), type text),
				    AddYearMonthNumber = Table.AddColumn(AddMonthYear, "Year Month Number", each [Year] * 100 + [Month Number], Int64.Type)
				in
				    AddYearMonthNumber

